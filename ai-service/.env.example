# Copy this file to .env and fill in your real keys.
# .env is gitignored —— never commit secrets.

AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# Reuse the project Redis (Sa-Token session + AI session share this Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容接口）
# ---------------------------------------------------------------------------
# 通义千问（阿里云百炼）兼容模式: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# 模型分级（🔴 core/llm_factory.py 用；这是省 60%+ 成本的关键）
# ---------------------------------------------------------------------------
# 理由：路由/分类调用量最大但最简单，用大模型是纯浪费。
#      「判定类」任务 temperature 一律 0（否则同一句话走不同分支，无法调试）。
LLM_MODEL_ROUTER=qwen-turbo          # 意图路由 / 查询改写
LLM_MODEL_CHAT=qwen-plus             # 最终生成（面向用户，质量优先）
LLM_MODEL_VERIFY=qwen-turbo          # 答后校验（判定任务）
LLM_TIMEOUT_SECONDS=8                # 🔴 单次模型调用超时，超了走兜底话术
LLM_MAX_TOKENS=800                   # 限制输出长度（越长越容易漂）

# ---------------------------------------------------------------------------
# Embedding / 向量（🔴 选定后不要随意更换！）
# ---------------------------------------------------------------------------
# 换 embedding 模型 = 全量重建向量库。不同模型的向量空间不通用，
# 混用会得到"看起来有结果但语义全错"的检索 —— 比报错难排查得多。
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024                   # 🔴 必须与向量库 mapping 的 dims 一致

# ---------------------------------------------------------------------------
# 图片生成（Phase 5；百炼是独立的异步接口，不是 /chat/completions）
# ---------------------------------------------------------------------------
# 调用前请在百炼控制台确认该模型已开通，否则会返回 Model.NotExist。
# 可选：wanx-v1 / wanx2.1-t2i-turbo / wanx2.1-t2i-plus / qwen-image
IMAGE_MODEL=wanx-v1
IMAGE_SIZE=1024*1024
IMAGE_STYLE=<auto>

# Safety limits
MAX_HISTORY_PER_SESSION=20
SSE_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Elasticsearch（Phase 3 就绪后启用；AI 检索的地基）
# ---------------------------------------------------------------------------
# ES_HOST=http://localhost:9200
# ES_PRODUCT_INDEX=products_read       # 用别名！重建索引时切别名可零停机
# ES_POLICY_INDEX=ai_policy            # 平台规则/FAQ 的向量索引

# ---------------------------------------------------------------------------
# Agent 循环控制（🔴 不加这些一定会死循环烧钱）
# ---------------------------------------------------------------------------
# AGENT_MAX_STEPS=4                    # ReAct 最大步数（3~5）
# AGENT_TOTAL_TIMEOUT_SECONDS=15       # 整条链路总超时
# TOOL_TIMEOUT_SECONDS=1.5             # 单个工具调用超时
# TOOL_RESULT_MAX_ITEMS=5              # 单工具结果条数上限
# VERIFY_MAX_REWRITE=1                 # 🔴 答后校验的重写次数上限（防死循环）

# ---------------------------------------------------------------------------
# 成本护栏
# ---------------------------------------------------------------------------
# RATE_LIMIT_PER_USER_PER_MINUTE=20    # 按用户限流（防刷对话）
# MAX_TURNS_PER_SESSION=20             # 单会话最大轮数
# DAILY_BUDGET_ALERT_USD=10            # 单日成本告警阈值

# ---------------------------------------------------------------------------
# 后端服务（ai-service 调工具时走**网关**，不直连微服务）
# ---------------------------------------------------------------------------
# 🔴 走网关的理由：鉴权、限流、熔断都挂在网关上；
#    直连 product-service 会绕过所有这些（包括那段内部接口 403 拦截）。
# GATEWAY_BASE_URL=http://localhost:8080
